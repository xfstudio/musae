{
  "expo": {
    "name": "Musae",
    "slug": "musae",
    "scheme": "musae",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.musae.mobile" },
    "android": { "package": "app.musae.mobile" },
    "web": { "bundler": "metro", "name": "Musae — a little room for everything" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
