# Copy the required settings into your private .env. Never commit secrets.
WORKSPACE_MODE=live
AGENT_BACKEND=model
HOST=127.0.0.1
PORT=8787
PUBLIC_WEB_URL=https://musae.ai
PUBLIC_API_URL=https://api.musae.ai
EXPO_PUBLIC_API_URL=https://api.musae.ai
ALLOWED_ORIGINS=https://musae.ai,http://localhost:8081,http://127.0.0.1:8081
WEB_HOST=0.0.0.0
WEB_PORT=8081
BROWSER_WORKER_URL=https://web.musae.ai
WORKER_HOST=127.0.0.1
WORKER_DATA_DIR=.musae/browser-profiles
DATA_DIR=.musae/production
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://musae:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:55432/musae
TASK_WORKER_ENABLED=true
WEB_SEARCH_ENABLED=true

# Preserve existing values when updating an installation.
MUSAE_ACCESS_KEY=
TOKEN_ENCRYPTION_KEY=
WORKER_TOKEN=
CPK_INTELLIGENCE_API_KEY=
MODEL=openai/your-model-id
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# WORKER_DNS_SERVERS=

# Keep the original deployment identity when changing the public API hostname.
# COMPUTER_DEPLOYMENT_ID=
COMPUTER_ENABLED=false
COMPUTER_IMAGE=musae-computer:local
JEV_MODE=off
